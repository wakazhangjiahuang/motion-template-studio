{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_sha256",
    "duration",
    "continuous_review",
    "scenes",
    "unknowns"
  ],
  "properties": {
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "continuous_review": {
      "enum": [
        "NOT_RUN",
        "PARTIAL",
        "COMPLETE"
      ]
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "start",
          "end",
          "observations",
          "implementation",
          "acceptance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "observations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "statement",
                "evidence"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "fact",
                    "inference",
                    "unknown"
                  ]
                },
                "statement": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "end": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "implementation": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
